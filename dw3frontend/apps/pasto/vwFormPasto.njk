<!-- arquivo: apps/pasto/vwFormPasto.njk -->

{% extends "layout.njk" %}

{% block content %}
  <header class="page-header">
    <p class="page-kicker text-marrom fw-semibold mb-2">Cadastro</p>
    <h1 class="h3 fw-bold mb-2" id="tituloForm">Formulário de pastos</h1>
    <p class="text-secondary mb-0">Manipule os dados cadastrais dos pastos.</p>
  </header>

  <div class="card page-card border-0 shadow-sm">
    <div class="card-body p-4">
      <h2 class="h5 fw-semibold mb-4">Dados do pasto</h2>

      <form id="frmPasto" data-servidor-dw3="{{ servidorDw3 }}">
        <input type="hidden" id="pastoid" name="pastoid" value="0">
        <input type="hidden" id="removido" name="removido" value="false">

        <div class="row g-3">
          <div class="col-12 col-md-8">
            <label for="descricao" class="form-label">Descrição</label>
            <input type="text" class="form-control" id="descricao" name="descricao" maxlength="60" placeholder="Ex.: Pasto da Sede" required>
          </div>

          <div class="col-12 col-md-4">
            <label for="areatotal" class="form-label">Área total (hectares)</label>
            <input type="number" class="form-control" id="areatotal" name="areatotal" min="0" step="0.01" placeholder="0,00" required>
          </div>
        </div>

        <div class="d-flex flex-column flex-sm-row gap-2 mt-4">
          <button type="button" class="btn btn-primary d-none" id="btnInserirPasto">
            <i class="bi bi-plus-lg me-1"></i>Inserir
          </button>
          <button type="button" class="btn btn-warning d-none" id="btnAtualizarPasto">
            <i class="bi bi-pencil-square me-1"></i>Salvar alterações
          </button>
          <button type="button" class="btn btn-danger d-none" id="btnRemoverPasto">
            <i class="bi bi-trash me-1"></i>Remover
          </button>
          <a class="btn btn-outline-secondary" href="/pasto" id="btnFecharPasto">
            <i class="bi bi-x-lg me-1"></i>Fechar
          </a>
        </div>
      </form>
    </div>
  </div>

  <script src="/js/dw3frontend.js"></script>
  <script src="/apps/pasto/vwFormPasto.js"></script>
{% endblock %}
