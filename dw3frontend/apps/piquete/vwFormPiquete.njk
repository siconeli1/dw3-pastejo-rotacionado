{% extends "layout.njk" %}

{% block content %}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css">

  <header class="page-header">
    <p class="page-kicker text-marrom fw-semibold mb-2">Cadastro</p>
    <h1 class="h3 fw-bold mb-2" id="tituloForm">Formulário de piquetes</h1>
    <p class="text-secondary mb-0">Manipule os dados cadastrais dos piquetes.</p>
  </header>

  <div class="card page-card border-0 shadow-sm">
    <div class="card-body p-4">
      <h2 class="h5 fw-semibold mb-4">Dados do piquete</h2>

      <form id="frmPiquete" data-servidor-dw3="{{ servidorDw3 }}">
        <input type="hidden" id="piqueteid" name="piqueteid" value="0">
        <input type="hidden" id="removido" name="removido" value="false">

        <div class="row g-3">
          <div class="col-12 col-md-6">
            <label for="descricao" class="form-label">Descrição</label>
            <input type="text" class="form-control" id="descricao" name="descricao" maxlength="60" placeholder="Ex.: Piquete 01" required>
          </div>

          <div class="col-12 col-md-6">
            <label for="pastoidfk" class="form-label">Pasto</label>
            <select class="form-select" id="pastoidfk" name="pastoidfk" required>
              <option value="">Selecione um pasto</option>
            </select>
          </div>

          <div class="col-12 col-md-4">
            <label for="latitude" class="form-label">Latitude</label>
            <input type="number" class="form-control" id="latitude" name="latitude" min="-90" max="90" step="0.0000001" placeholder="Ex.: -20.4237000" required>
          </div>

          <div class="col-12 col-md-4">
            <label for="longitude" class="form-label">Longitude</label>
            <input type="number" class="form-control" id="longitude" name="longitude" min="-180" max="180" step="0.0000001" placeholder="Ex.: -49.9781000" required>
          </div>

          <div class="col-12 col-md-4 d-flex align-items-end">
            <a class="btn btn-outline-secondary w-100 disabled" id="lnkMapa" href="#" target="_blank" rel="noopener">
              <i class="bi bi-geo-alt me-1"></i>Ver no mapa
            </a>
          </div>
        </div>

        <div class="d-flex flex-column flex-sm-row gap-2 mt-4">
          <button type="button" class="btn btn-primary d-none" id="btnInserirPiquete">
            <i class="bi bi-plus-lg me-1"></i>Inserir
          </button>
          <button type="button" class="btn btn-warning d-none" id="btnAtualizarPiquete">
            <i class="bi bi-pencil-square me-1"></i>Salvar alterações
          </button>
          <button type="button" class="btn btn-danger d-none" id="btnRemoverPiquete">
            <i class="bi bi-trash me-1"></i>Remover
          </button>
          <a class="btn btn-outline-secondary" href="/piquete" id="btnFecharPiquete">
            <i class="bi bi-x-lg me-1"></i>Fechar
          </a>
        </div>
      </form>
    </div>
  </div>

  <script src="/js/dw3frontend.js"></script>
  <script src="https://code.jquery.com/jquery-4.0.0.slim.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
  <script src="/apps/piquete/vwFormPiquete.js"></script>
{% endblock %}
