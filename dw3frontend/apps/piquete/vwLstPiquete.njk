<!-- arquivo: apps/piquete/vwLstPiquete.njk -->

{% extends "layout.njk" %}

{% block content %}
  <link rel="stylesheet" href="https://cdn.datatables.net/2.1.8/css/dataTables.bootstrap5.css">

  <header class="page-header">
    <p class="page-kicker text-marrom fw-semibold mb-2">Cadastro</p>
    <h1 class="h3 fw-bold mb-2">Piquetes</h1>
    <p class="text-secondary mb-0">Consulte os piquetes de cada pasto e sua localização.</p>
  </header>

  <div class="card page-card border-0 shadow-sm">
    <div class="card-body p-4">
      <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-md-between gap-3 mb-4">
        <div>
          <h2 class="h5 fw-semibold mb-1">Lista de piquetes</h2>
          <p class="text-secondary mb-0">Use os botões da coluna Operações para visualizar, alterar ou remover.</p>
        </div>
        <a class="btn btn-primary" href="/piquete/form?oper=Cr" id="btnNovoPiquete">
          <i class="bi bi-plus-lg me-1"></i>Incluir novo piquete
        </a>
      </div>

      <div id="piqueteAlert" class="alert alert-danger d-none" role="alert"></div>

      <div id="piqueteListagem" data-servidor-dw3="{{ servidorDw3 }}">
        <div class="table-responsive">
          <table id="tblPiquete" class="table table-striped table-hover align-middle w-100">
            <thead>
              <tr>
                <th>ID</th>
                <th>Descrição</th>
                <th>Pasto</th>
                <th>Latitude</th>
                <th>Longitude</th>
                <th>Mapa</th>
                <th>Operações</th>
              </tr>
            </thead>
            <tbody></tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <script src="/js/dw3frontend.js"></script>
  <script src="https://code.jquery.com/jquery-4.0.0.slim.min.js"></script>
  <script src="https://cdn.datatables.net/2.1.8/js/dataTables.js"></script>
  <script src="https://cdn.datatables.net/2.1.8/js/dataTables.bootstrap5.js"></script>
  <script src="/apps/piquete/vwLstPiquete.js"></script>
{% endblock %}
